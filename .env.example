# Copy this file to .env.local for development. Never commit .env.local.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TIME_ZONE=America/Chicago
DATABASE_URL=postgresql://chopw@127.0.0.1:55432/chopw_fleet
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=

# Development identity bypass. The application rejects this mode in production.
AUTH_MODE=development
DEV_ACTOR_EMAIL=admin@local.invalid

# Required in production when AUTH_MODE=oidc. Keep values outside Git.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES=openid profile email
OIDC_CLOCK_TOLERANCE_SECONDS=30
AUTH_SECRET=
SESSION_MAX_AGE_MINUTES=480
TRUST_PROXY_HEADERS=false

# Outbound email is captured locally unless EMAIL_MODE=smtp.
EMAIL_MODE=capture
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_AUTH_MODE=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
EMAIL_FROM=

# Production file storage must be a persistent mounted path or object-store adapter.
FILE_STORAGE_ROOT=./var/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_USER_DAILY_LIMIT=20
UPLOAD_PROCESSING_CONCURRENCY=2
UPLOAD_PROCESSING_QUEUE_LIMIT=4
STORAGE_MIN_FREE_BYTES=1073741824
FILE_SCANNING_MODE=disabled
CLAMAV_SOCKET_PATH=
CLAMAV_HOST=
CLAMAV_PORT=3310
REPORT_ARTIFACT_RETENTION_DAYS=365
REPORT_MAX_ROWS=25000
REPORT_PDF_DETAIL_ROW_LIMIT=2000
REPORT_RENDER_CONCURRENCY=2
REPORT_RENDER_QUEUE_LIMIT=4
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MINUTES=5
