# Non-secret Compose/deployment settings. Install as /etc/harvey-pw-fleet/deploy.env.
FLEET_APP_ENV_FILE=/etc/harvey-pw-fleet/app.env
FLEET_DATABASE_ENV_FILE=/etc/harvey-pw-fleet/database.env
FLEET_HTTP_PORT=3000
FLEET_APP_IMAGE=harvey-pw-fleet:local
FLEET_WORKER_IMAGE=harvey-pw-fleet-worker:local
FLEET_UPLOADS_VOLUME=harvey-pw-fleet_uploads
FLEET_DATABASE_VOLUME=harvey-pw-fleet_database
FLEET_DATABASE_TLS_DIR=/etc/harvey-pw-fleet/database-tls
FLEET_DATABASE_CA_HOST_FILE=/etc/harvey-pw-fleet/database-tls/ca.crt
