# Install as /etc/pwfleet/app.env with owner root, group pwfleet, and mode 0640.
# Empty security-sensitive values are intentional and keep production fail closed.
NODE_ENV=production
APP_BASE_URL=https://pwfleet.cityofharveyil.gov
APP_TIME_ZONE=America/Chicago
DATABASE_URL=
DATABASE_POOL_MAX=20
DATABASE_SSL_MODE=require
DATABASE_SSL_CA_FILE=/etc/pwfleet/database-ca.crt

AUTH_MODE=oidc
DEV_ACTOR_EMAIL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPES="openid profile email"
OIDC_CLOCK_TOLERANCE_SECONDS=30
AUTH_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_IDENTITY_SUBJECT=
SESSION_MAX_AGE_MINUTES=480
TRUST_PROXY_HEADERS=true

EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_MODE=oauth2
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
EMAIL_FROM=
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MINUTES=5

FILE_STORAGE_ROOT=/var/lib/pwfleet/uploads
UPLOAD_MAX_BYTES=10485760
UPLOAD_USER_DAILY_LIMIT=20
UPLOAD_PROCESSING_CONCURRENCY=2
UPLOAD_PROCESSING_QUEUE_LIMIT=4
STORAGE_MIN_FREE_BYTES=1073741824
FILE_SCANNING_MODE=clamav
CLAMAV_SOCKET_PATH=/run/clamav/clamd.ctl
CLAMAV_HOST=
CLAMAV_PORT=
REPORT_ARTIFACT_RETENTION_DAYS=365
REPORT_MAX_ROWS=25000
REPORT_PDF_DETAIL_ROW_LIMIT=2000
REPORT_RENDER_CONCURRENCY=2
REPORT_RENDER_QUEUE_LIMIT=4
