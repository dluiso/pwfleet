limit_req_zone $binary_remote_addr zone=fleet_web:10m rate=20r/s;
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${FLEET_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${FLEET_HOSTNAME};

    ssl_certificate ${TLS_CERTIFICATE_PATH};
    ssl_certificate_key ${TLS_PRIVATE_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:FleetTLS:10m;
    ssl_session_tickets off;

    client_max_body_size 11m;
    limit_req zone=fleet_web burst=40 nodelay;

    location / {
        proxy_pass http://127.0.0.1:${FLEET_HTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
